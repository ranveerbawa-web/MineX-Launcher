<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/minex_green_light">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_4sdp" />
                    <solid android:color="@color/minex_green_dark" />
                </shape>
            </item>
            <item android:bottom="@dimen/_3sdp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_4sdp" />
                    <gradient
                        android:angle="90"
                        android:startColor="@color/minex_green"
                        android:endColor="#4FA23A" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
